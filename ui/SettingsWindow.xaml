<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DictateUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DictateUI">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: Windows draws the buttons at the right; this strip is where the window is dragged. -->
        <Grid x:Name="TitleBar" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock Text="Dictate settings" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left" OpenPaneLength="208"
                        IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" AlwaysShowHeader="False"
                        SelectionChanged="OnNavSelectionChanged" ItemInvoked="OnNavItemInvoked">

            <NavigationView.PaneHeader>
                <TextBlock Text="Settings" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="16,4,0,10" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dictation" Tag="dictation" AutomationProperties.Name="Dictation">
                    <NavigationViewItem.Icon>

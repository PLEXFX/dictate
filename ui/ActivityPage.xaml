<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DictateUI.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DictateUI"
    NavigationCacheMode="Required">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="900" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="36,24,36,36" Spacing="8">

                <TextBlock Text="Activity bar" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Choose how the compact waveform appears and leaves the screen." Style="{StaticResource PageDescStyle}" Margin="0,0,0,12" />

                <local:SettingsGroup>
                    <local:SettingsRow Title="Bar width" Description="Adjust the activity bar without changing the waveform behavior.">
                        <local:SteppedSlider x:Name="WidthSlider" AutomationProperties.Name="Bar width" />
                    </local:SettingsRow>
                    <local:SettingsRow Title="Always show activity bar" Description="Off means it appears only while you are dictating.">
                        <ToggleSwitch x:Name="VisibleToggle" AutomationProperties.Name="Always show activity bar" Toggled="OnVisibleToggled" />
                    </local:SettingsRow>
                    <local:SettingsRow Title="Distance from taskbar" Description="Gap between the activity bar and the taskbar; 8 px is the default.">
                        <local:SteppedSlider x:Name="MarginSlider" AutomationProperties.Name="Distance from taskbar" />
                    </local:SettingsRow>
                    <local:SettingsRow Title="Stay after finishing" Description="How long the bar stays on screen after dictation finishes, before it fades away.">
                        <local:SteppedSlider x:Name="LingerSlider" AutomationProperties.Name="Stay after finishing" />
                    </local:SettingsRow>
                </local:SettingsGroup>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activity bar" Tag="activity" AutomationProperties.Name="Activity bar">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="M7.00383 3.00001C7.22848 3.00173 7.4244 3.15308 7.48281 3.37001L10.526 14.6733L13.0211 6.35633C13.0828 6.15078 13.2687 6.0075 13.4832 6.00028C13.6976 5.99306 13.8928 6.12351 13.9682 6.32444L15.3465 10H17.5C17.7761 10 18 10.2239 18 10.5C18 10.7761 17.7761 11 17.5 11H15C14.7916 11 14.605 10.8707 14.5318 10.6756L13.5527 8.06447L10.9789 16.6437C10.9147 16.8577 10.7163 17.0031 10.4929 16.9999C10.2695 16.9968 10.0753 16.8457 10.0172 16.63L6.98569 5.37012L5.48076 10.6374C5.41943 10.852 5.22324 11 5 11H2.5C2.22386 11 2 10.7761 2 10.5C2 10.2239 2.22386 10 2.5 10H4.62285L6.51924 3.36264C6.58096 3.14662 6.77917 2.9983 7.00383 3.00001Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Appearance" Tag="appearance" AutomationProperties.Name="Appearance">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="F0 M10 2C5.58172 2 2 5.58172 2 10C2 14.4183 5.58172 18 10 18C10.9665 18 11.75 17.2165 11.75 16.25C11.75 15.8 11.58 15.39 11.3 15.08C11.03 14.78 10.86 14.38 10.86 13.94C10.86 12.98 11.64 12.2 12.6 12.2H14.65C16.5 12.2 18 10.7 18 8.85C18 5.06 14.42 2 10 2ZM3.2 10C3.2 6.24446 6.24446 3.2 10 3.2C13.8608 3.2 16.8 5.83571 16.8 8.85C16.8 10.0374 15.8374 11 14.65 11H12.6C10.9772 11 9.66 12.3172 9.66 13.94C9.66 14.6835 9.94818 15.3643 10.4046 15.8735C10.4967 15.9762 10.55 16.1076 10.55 16.25C10.55 16.5538 10.3038 16.8 10 16.8C6.24446 16.8 3.2 13.7555 3.2 10ZM6.25 10.75C6.94036 10.75 7.5 10.1904 7.5 9.5C7.5 8.80964 6.94036 8.25 6.25 8.25C5.55964 8.25 5 8.80964 5 9.5C5 10.1904 5.55964 10.75 6.25 10.75ZM9.25 7.75C9.94036 7.75 10.5 7.19036 10.5 6.5C10.5 5.80964 9.94036 5.25 9.25 5.25C8.55964 5.25 8 5.80964 8 6.5C8 7.19036 8.55964 7.75 9.25 7.75ZM14 7.75C14.6904 7.75 15.25 7.19036 15.25 6.5C15.25 5.80964 14.6904 5.25 14 5.25C13.3096 5.25 12.75 5.80964 12.75 6.5C12.75 7.19036 13.3096 7.75 14 7.75ZM6.5 14.25C7.19036 14.25 7.75 13.6904 7.75 13C7.75 12.3096 7.19036 11.75 6.5 11.75C5.80964 11.75 5.25 12.3096 5.25 13C5.25 13.6904 5.80964 14.25 6.5 14.25Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Updates" Tag="updates" AutomationProperties.Name="Updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Privacy" Tag="privacy" AutomationProperties.Name="Privacy">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="6,0,6,10" Spacing="2">

                    <!-- Shows only when a download, an update, a setup step or an error needs attention. -->
                    <Button x:Name="Chip" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="12,10" Margin="0,0,0,6" Click="OnChipClick" AutomationProperties.Name="Downloads and updates">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="ChipIcon" FontSize="18" VerticalAlignment="Top" Margin="0,1,0,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="ChipTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ChipDetail" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <ProgressBar x:Name="ChipBar" Margin="0,4,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Button>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0,4,4" />
                    <Button x:Name="WhatsNewButton" Content="What's new" Style="{StaticResource QuietButtonStyle}" Click="OnWhatsNew"
                            AutomationProperties.Name="What's new" />
                    <Button x:Name="GitHubButton" Content="GitHub" Style="{StaticResource QuietButtonStyle}" Click="OnGitHub"
                            AutomationProperties.Name="GitHub" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="8,2,0,0" />

                    <DropDownButton x:Name="DemoMenu" Content="Demo states" Visibility="Collapsed" Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="Demo states" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>

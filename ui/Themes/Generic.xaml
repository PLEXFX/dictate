<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DictateUI">

    <Style TargetType="local:SettingsRow">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SettingsRow">
                    <Grid x:Name="RootGrid" MinHeight="56" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Rectangle x:Name="DividerLine" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed" />

                        <ContentPresenter x:Name="IconHost" Margin="16,0,0,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding Icon}" Visibility="Collapsed" />

                        <StackPanel x:Name="CopyPanel" Grid.Column="1" Margin="16,12,16,12" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}"
                                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DescText" Text="{TemplateBinding Description}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>

                        <ContentPresenter x:Name="DetailHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                          Margin="16,0,16,12" Content="{TemplateBinding Detail}" Visibility="Collapsed" />

                        <ContentPresenter x:Name="SlotHost" Grid.Column="2" Margin="0,8,16,8"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          Content="{TemplateBinding Content}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

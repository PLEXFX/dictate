<UserControl
    x:Class="DictateUI.SteppedSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="230">

    <StackPanel Spacing="2">
        <TextBlock x:Name="ValueText" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Slider x:Name="Track" Minimum="0" StepFrequency="1" SnapsTo="StepValues" TickFrequency="1"
                ValueChanged="OnTrackChanged" />
    </StackPanel>
</UserControl>
